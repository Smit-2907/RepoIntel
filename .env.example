# --- Database (Supabase Postgres / local docker) ---
DATABASE_URL=postgres://postgres:postgres@localhost:54322/codebaseintel?sslmode=disable

# --- Services ---
API_PORT=8080
PARSER_URL=http://localhost:8090
PARSER_PORT=8090

# --- GitHub (optional but recommended: 60 req/h unauthenticated vs 5,000 with a PAT) ---
GITHUB_PAT=

# --- Gemini (optional: when empty, the app runs in stub mode for local demos) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# --- Limits (frozen scope, handoff §6.2) ---
MAX_REPO_KB=51200
MAX_FILES=3000
MAX_FILE_BYTES=524288
MAX_CHUNKS=15000
ANALYSIS_TIMEOUT_SECONDS=600

# --- Frontend ---
VITE_API_URL=http://localhost:8081
